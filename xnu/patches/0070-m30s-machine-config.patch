diff --git a/osfmk/arm/m30s_mpidr.c b/osfmk/arm/m30s_mpidr.c
new file mode 100644
--- /dev/null
+++ b/osfmk/arm/m30s_mpidr.c
@@ -0,0 +1,100 @@
+/*
+ * M30S MPIDR handling for Exynos 9611 (4x A53 + 4x A73).
+ *
+ * MPIDR format:
+ *   Aff1 (bits 15:8) = cluster ID (0 = LITTLE/A53, 1 = BIG/A73)
+ *   Aff0 (bits 7:0) = core ID within cluster (0-3)
+ */
+#if defined(ARM64_BOARD_CONFIG_M30S)
+#include <kern/kern_types.h>
+#include <machine/machine_routines.h>
+
+int
+m30s_mpidr_to_core_id(uint64_t mpidr)
+{
+	uint64_t aff0 = mpidr & 0xff;
+	uint64_t aff1 = (mpidr >> 8) & 0xff;
+
+	if (aff1 == 0) {
+		/* LITTLE cluster: cores 0-3 */
+		return (int)aff0;
+	} else if (aff1 == 1) {
+		/* BIG cluster: cores 4-7 */
+		return (int)aff0 + 4;
+	}
+	return -1;
+}
+
+uint64_t
+m30s_core_id_to_mpidr(int core_id)
+{
+	if (core_id < 4) {
+		/* LITTLE cluster */
+		return (uint64_t)core_id; /* Aff1=0, Aff0=core_id */
+	} else if (core_id < 8) {
+		/* BIG cluster */
+		return (1ULL << 8) | (uint64_t)(core_id - 4); /* Aff1=1, Aff0=core_id-4 */
+	}
+	return 0;
+}
+#endif /* ARM64_BOARD_CONFIG_M30S */
diff --git a/osfmk/arm/m30s_timer.c b/osfmk/arm/m30s_timer.c
new file mode 100644
--- /dev/null
+++ b/osfmk/arm/m30s_timer.c
@@ -0,0 +1,150 @@
+/*
+ * M30S generic timer driver for Exynos 9611 (26 MHz).
+ */
+#if defined(ARM64_BOARD_CONFIG_M30S)
+#include <kern/kern_types.h>
+#include <mach/machine.h>
+#include <machine/machine_routines.h>
+
+#define TIMEBASE_FREQ		26000000UL
+#define VTIMER_INTID		13	/* PPI 13 (CNTV) */
+#define PTIMER_INTID		14	/* PPI 14 (CNTP) */
+
+void
+m30s_timer_init(void)
+{
+	/* Set timer frequency */
+	__asm__ volatile("msr cntfrq_el0, %0" : : "r"(TIMEBASE_FREQ));
+	__asm__ volatile("isb");
+
+	/* Enable virtual timer interrupt */
+	__asm__ volatile("msr cntv_ctl_el0, %0" : : "r"(1));
+	__asm__ volatile("isb");
+}
+
+uint64_t
+m30s_timer_read(void)
+{
+	uint64_t val;
+	__asm__ volatile("mrs %0, cntpct_el0" : "=r"(val));
+	return val;
+}
+
+void
+m30s_timer_set_deadline(uint64_t deadline)
+{
+	uint64_t now = m30s_timer_read();
+	uint64_t delta = (deadline > now) ? (deadline - now) : 1;
+	__asm__ volatile("msr cntv_tval_el0, %0" : : "r"(delta));
+	__asm__ volatile("isb");
+}
+
+void
+m30s_timer_cancel(void)
+{
+	__asm__ volatile("msr cntv_ctl_el0, %0" : : "r"(0));
+	__asm__ volatile("isb");
+}
+#endif /* ARM64_BOARD_CONFIG_M30S */
diff --git a/osfmk/arm/m30s_psci.c b/osfmk/arm/m30s_psci.c
new file mode 100644
--- /dev/null
+++ b/osfmk/arm/m30s_psci.c
@@ -0,0 +1,150 @@
+/*
+ * M30S PSCI driver for Exynos 9611.
+ */
+#if defined(ARM64_BOARD_CONFIG_M30S)
+#include <kern/kern_types.h>
+#include <machine/machine_routines.h>
+
+#define PSCI_VERSION		0x84000000UL
+#define PSCI_CPU_SUSPEND	0xc4000001UL
+#define PSCI_CPU_OFF		0x84000002UL
+#define PSCI_CPU_ON		0xc4000003UL
+#define PSCI_MIGRATE_INFO_TYPE	0x84000006UL
+#define PSCI_SYSTEM_RESET	0x84000009UL
+#define PSCI_FEATURES		0x8400000aUL
+#define PSCI_SYSTEM_SUSPEND	0xc400000eUL
+#define PSCI_SYSTEM_RESET2	0xc4000012UL
+#define SMCCC_VERSION		0x80000000UL
+
+static uint64_t
+smc(uint64_t fn, uint64_t a1, uint64_t a2, uint64_t a3)
+{
+	register uint64_t x0 __asm__("x0") = fn;
+	register uint64_t x1 __asm__("x1") = a1;
+	register uint64_t x2 __asm__("x2") = a2;
+	register uint64_t x3 __asm__("x3") = a3;
+	__asm__ volatile("smc #0"
+			 : "+r"(x0), "+r"(x1), "+r"(x2), "+r"(x3)
+			 :
+			 : "x4", "x5", "x6", "x7", "x8", "x9", "x10", "x11",
+			   "x12", "x13", "x14", "x15", "x16", "x17", "memory");
+	return x0;
+}
+
+int
+m30s_psci_init(void)
+{
+	uint64_t ver = smc(PSCI_VERSION, 0, 0, 0);
+	uint64_t smccc = smc(SMCCC_VERSION, 0, 0, 0);
+
+	/* Check PSCI version >= 1.0 */
+	if ((ver >> 16) < 1) {
+		return -1;
+	}
+	return 0;
+}
+
+int
+m30s_psci_cpu_on(uint64_t mpidr, uint64_t entry, uint64_t context)
+{
+	return (int)smc(PSCI_CPU_ON, mpidr, entry, context);
+}
+
+int
+m30s_psci_cpu_off(void)
+{
+	return (int)smc(PSCI_CPU_OFF, 0, 0, 0);
+}
+
+int
+m30s_psci_cpu_suspend(uint64_t state, uint64_t entry, uint64_t context)
+{
+	return (int)smc(PSCI_CPU_SUSPEND, state, entry, context);
+}
+
+int
+m30s_psci_system_reset(void)
+{
+	smc(PSCI_SYSTEM_RESET, 0, 0, 0);
+	return 0; /* Not reached */
+}
+#endif /* ARM64_BOARD_CONFIG_M30S */
diff --git a/osfmk/arm/m30s_gic.c b/osfmk/arm/m30s_gic.c
new file mode 100644
--- /dev/null
+++ b/osfmk/arm/m30s_gic.c
@@ -0,0 +1,250 @@
+/*
+ * M30S GICv3 driver for Exynos 9611.
+ *
+ * Distributor: 0x12301000
+ * Redistributors: 0x12302000 (size 0x200000)
+ * Timer PPI INTIDs: 13 (CNTV), 14 (CNTP)
+ */
+#if defined(ARM64_BOARD_CONFIG_M30S)
+#include <kern/kern_types.h>
+#include <machine/machine_routines.h>
+
+#define GICD_BASE		0x12301000UL
+#define GICR_BASE		0x12302000UL
+#define GICR_SIZE		0x200000UL
+#define GICR_PE_SIZE		0x20000UL
+#define GICR_TYPER		0x08
+#define GICR_WAKER		0x14
+#define GICR_SGI		0x10000
+#define GICR_IGROUPR0		(GICR_SGI + 0x080)
+#define GICR_ISENABLER0		(GICR_SGI + 0x100)
+#define GICR_ICENABLER0		(GICR_SGI + 0x180)
+#define GICR_IPRIORITYR		(GICR_SGI + 0x400)
+#define GICR_ISPENDR0		(GICR_SGI + 0x200)
+#define GICR_ISACTIVER0		(GICR_SGI + 0x300)
+#define GICR_ICFGR1		(GICR_SGI + 0xc04)
+
+#define VTIMER_INTID		13
+#define PTIMER_INTID		14
+#define SGI_INTID		1
+
+static inline uint32_t rd32(uintptr_t a) { return *(volatile uint32_t *)a; }
+static inline void wr32(uintptr_t a, uint32_t v) { *(volatile uint32_t *)a = v; }
+static inline uint64_t rd64(uintptr_t a) { return *(volatile uint64_t *)a; }
+static inline void wsr(const char *r, uint64_t v) { __asm__ volatile("msr " r ", %0" : : "r"(v)); }
+static inline uint64_t rsr(const char *r) { uint64_t v; __asm__ volatile("mrs %0, " r : "=r"(v)); return v; }
+static inline void isb(void) { __asm__ volatile("isb" ::: "memory"); }
+static inline void dsb(void) { __asm__ volatile("dsb sy" ::: "memory"); }
+
+static uintptr_t
+find_gicr(void)
+{
+	uint64_t aff = rsr("mpidr_el1");
+	uint32_t want = (aff & 0xffffff) | ((aff >> 8) & 0xff000000);
+
+	for (uintptr_t off = 0; off < GICR_SIZE; off += GICR_PE_SIZE) {
+		uint64_t typer = rd64(GICR_BASE + off + GICR_TYPER);
+		if ((uint32_t)(typer >> 32) == want)
+			return GICR_BASE + off;
+		if (typer & (1 << 4))	/* Last */
+			break;
+	}
+	return 0;
+}
+
+static void
+gicd_wait_rwp(void)
+{
+	for (int i = 0; i < 1000000 && (rd32(GICD_BASE) & (1U << 31)); i++)
+		;
+}
+
+void
+m30s_gic_init(void)
+{
+	/* Enable GIC system register interface */
+	uint64_t sre = rsr("icc_sre_el1");
+	if (!(sre & 1)) {
+		wsr("icc_sre_el1", sre | 1);
+		isb();
+	}
+
+	/* Configure distributor */
+	uint32_t dctlr = rd32(GICD_BASE);
+	wr32(GICD_BASE, dctlr | 0x13); /* EnableGrp1 | EnableGrp1A | ARE_NS */
+	gicd_wait_rwp();
+
+	/* Configure redistributor for this core */
+	uintptr_t r = find_gicr();
+	if (!r) {
+		panic("M30S: GICR not found");
+	}
+
+	/* Wake up redistributor */
+	uint32_t waker = rd32(r + GICR_WAKER);
+	if (waker & 2) {
+		wr32(r + GICR_WAKER, waker & ~2U);
+		for (int i = 0; i < 100000 && (rd32(r + GICR_WAKER) & 4); i++)
+			;
+	}
+
+	/* Set all interrupts to Group 1 (non-secure) */
+	wr32(r + GICR_IGROUPR0, 0xffffffff);
+
+	/* Set priorities */
+	for (int id = 0; id < 32; id++)
+		wr8(r + GICR_IPRIORITYR + id, 0xa0);
+
+	/* Enable timer PPIs and SGI */
+	wr32(r + GICR_ISENABLER0, (1U << VTIMER_INTID) | (1U << PTIMER_INTID) | (1U << SGI_INTID));
+
+	/* Configure CPU interface */
+	uint64_t ctlr = rsr("icc_ctlr_el1");
+	wsr("icc_ctlr_el1", ctlr & ~2ULL);	/* EOImode 0 */
+	wsr("icc_pmr_el1", 0xf0);
+	wsr("icc_bpr1_el1", 0);
+	wsr("icc_igrpen1_el1", 1);
+	isb();
+}
+#endif /* ARM64_BOARD_CONFIG_M30S */
diff --git a/osfmk/arm/m30s_smp.c b/osfmk/arm/m30s_smp.c
new file mode 100644
--- /dev/null
+++ b/osfmk/arm/m30s_smp.c
@@ -0,0 +1,200 @@
+/*
+ * M30S SMP initialization for Exynos 9611 (4x A53 + 4x A73).
+ */
+#if defined(ARM64_BOARD_CONFIG_M30S)
+#include <kern/kern_types.h>
+#include <kern/thread.h>
+#include <kern/sched_prim.h>
+#include <machine/machine_routines.h>
+#include <pexpert/pexpert.h>
+
+extern void m30s_psci_cpu_on(uint64_t mpidr, uint64_t entry, uint64_t context);
+extern void secondary_start(void);
+
+static uint64_t cpu_mpidrs[8];
+
+void
+m30s_smp_init(void)
+{
+	/* Boot CPU is already running */
+	cpu_mpidrs[0] = __builtin_arm_rsr64("mpidr_el1");
+
+	/* Start secondary cores: 1-3 (A53 little), 4-7 (A73 big) */
+	/* MPIDR format: Aff1=cluster (0=LITTLE, 1=BIG), Aff0=core (0-3) */
+	for (int i = 1; i < 4; i++) {
+		/* LITTLE cluster cores */
+		uint64_t mpidr = (uint64_t)i; /* Aff1=0, Aff0=i */
+		cpu_mpidrs[i] = mpidr;
+		m30s_psci_cpu_on(mpidr, (uint64_t)secondary_start, i);
+	}
+
+	for (int i = 4; i < 8; i++) {
+		/* BIG cluster cores */
+		uint64_t mpidr = (1ULL << 8) | (uint64_t)(i - 4); /* Aff1=1, Aff0=i-4 */
+		cpu_mpidrs[i] = mpidr;
+		m30s_psci_cpu_on(mpidr, (uint64_t)secondary_start, i);
+	}
+}
