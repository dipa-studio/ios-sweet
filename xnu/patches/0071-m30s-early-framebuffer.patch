+
+void
+m30s_fb_init(uint64_t phys_base, uint32_t width, uint32_t height, uint32_t stride)
+{
+	fb_va = ml_io_map(phys_base, height * stride);
+	fb_width = width;
+	fb_height = height;
+	fb_stride = stride;
+	cursor_x = 0;
+	cursor_y = 0;
+
+	/* Clear screen */
+	if (fb_va) {
+		uint32_t *fb = (uint32_t *)fb_va;
+		for (uint32_t y = 0; y < fb_height; y++) {
+			for (uint32_t x = 0; x < fb_width; x++) {
+				fb[y * (fb_stride / 4) + x] = 0xff000000; /* Black */
+			}
+		}
+	}
+}
+
+static void
+fb_scroll_up(void)
+{
+	if (!fb_va)
+		return;
+	uint32_t *fb = (uint32_t *)fb_va;
+	uint32_t row_bytes = fb_stride;
+	uint32_t rows_to_move = fb_height - char_h;
+
+	for (uint32_t y = 0; y < rows_to_move; y++) {
+		uint32_t *dst = (uint32_t *)((uintptr_t)fb + y * row_bytes);
+		uint32_t *src = (uint32_t *)((uintptr_t)fb + (y + char_h) * row_bytes);
+		for (uint32_t x = 0; x < fb_width; x++) {
+			dst[x] = src[x];
+		}
+	}
+
+	uint32_t *last_row = (uint32_t *)((uintptr_t)fb + rows_to_move * row_bytes);
+	for (uint32_t y = 0; y < char_h; y++) {
+		for (uint32_t x = 0; x < fb_width; x++) {
+			last_row[y * (fb_stride / 4) + x] = 0xff000000;
+		}
+	}
+	cursor_y = rows_to_move;
+}
+
+void
+m30s_fb_putc(char c)
+{
+	if (!fb_va || c == '\0')
+		return;
+
+	if (c == '\n') {
+		cursor_x = 0;
+		cursor_y += char_h;
+		if (cursor_y + char_h > fb_height)
+			fb_scroll_up();
+		return;
+	}
+
+	if (c == '\r') {
+		cursor_x = 0;
+		return;
+	}
+
+	if (c == '\t') {
+		cursor_x = (cursor_x + 8 * char_w) & ~(7 * char_w);
+		if (cursor_x >= fb_width) {
+			cursor_x = 0;
+			cursor_y += char_h;
+			if (cursor_y + char_h > fb_height)
+				fb_scroll_up();
+		}
+		return;
+	}
+
+	if ((unsigned char)c < 32 || (unsigned char)c >= 127)
+		c = '?';
+
+	const uint8_t *glyph = font8x16 + (c - 32) * 16;
+
+	for (uint32_t row = 0; row < 16; row++) {
+		uint8_t bits = glyph[row];
+		uint32_t y = cursor_y + row;
+		if (y >= fb_height)
+			break;
+
+		uint32_t *fb_row = (uint32_t *)((uintptr_t)fb_va + y * fb_stride + cursor_x * 4);
+
+		for (uint32_t col = 0; col < 8; col++) {
+			uint32_t x = cursor_x + col;
+			if (x >= fb_width)
+				break;
+			fb_row[col] = (bits & (1 << (7 - col))) ? 0xffffffff : 0xff000000;
+		}
+	}
+
+	cursor_x += 8;
+	if (cursor_x + 8 > fb_width) {
+		cursor_x = 0;
+		cursor_y += 16;
+		if (cursor_y + 16 > fb_height)
+			fb_scroll_up();
+	}
+}
+
+void
+m30s_fb_early_puts(const char *str)
+{
+	while (*str) {
+		m30s_fb_putc(*str++);
+	}
+}
