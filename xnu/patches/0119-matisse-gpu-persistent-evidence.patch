+static bool
+sweet_ufs_write_allowed(bool writable, bool diagnostic, uint64_t first,
+    uint64_t blocks, uint64_t lba, uint32_t count, uint32_t max_count)
+{
+	/* Subtractions follow their lower-bound checks; no wrapping end-LBA. */
+	if (!blocks || !count || count > max_count || lba < first ||
+	    lba - first >= blocks || count > blocks - (lba - first) ||
+	    lba > UINT32_MAX || count - 1 > UINT32_MAX - lba) {
+		return false;
+	}
+	/* Exactly the established 4 MiB console ring plus header. Only the
+	 * log caller requests this exception; the VFS remains read-only. */
+	return writable || (diagnostic && blocks >= 2050 &&
+	       lba - first >= blocks - 1025);
+}
+
+static int
+ufs_write_blocks_checked(uint64_t lba, uint32_t count, bool diagnostic)
+{
+	if (!sweet_ufs_write_allowed(su.writable, diagnostic, su.first_block,
+	    su.nblocks, lba, count, BOUNCE_SIZE / UFS_BLOCK)) {
