@@ -1859,10 +1859,18 @@ sleh_irq(arm_saved_state_t *state)
 #if defined(SWEET)
 	/*
 	 * sweet: TrustZone owns GIC Group 0, so the timer and IPIs that other
-	 * ARM64 targets take as FIQs arrive here as Group 1 IRQs.
+	 * ARM64 targets take as FIQs arrive here as Group 1 IRQs. The A51's
+	 * GICv2 has the same split, with a memory-mapped CPU interface.
 	 */
+#if HAS_GIC_V2
+	uint32_t iar = *(volatile uint32_t *)(sweet_gicc_base + GICC_IAR);
+	uint32_t intid = iar & 0x3FF;	/* bits 12:10 = SGI source, keep them for EOIR */
+#define SWEET_GIC_EOI(v) (*(volatile uint32_t *)(sweet_gicc_base + GICC_EOIR) = (uint32_t)(v))
+#else
 	uint64_t iar = __builtin_arm_rsr64("ICC_IAR1_EL1");
