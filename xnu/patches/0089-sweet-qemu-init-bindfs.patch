--- a/bsd/miscfs/bindfs/bind_vfsops.c
+++ b/bsd/miscfs/bindfs/bind_vfsops.c
@@ -73,8 +73,9 @@
 #include <security/mac_internal.h>
 
 #include <sys/param.h>
 
 #include <IOKit/IOBSD.h>
+#include <pexpert/pexpert.h>
 
 #include "bindfs.h"
 
@@ -108,6 +109,7 @@
 bindfs_mount(struct mount * mp, __unused vnode_t devvp, user_addr_t user_data, vfs_context_t ctx)
 {
 	int error                 = 0;
+	uint32_t qemu_virtio      = 0;
 	struct vnode *lowerrootvp = NULL, *vp = NULL;
 	struct vfsstatfs * sp   = NULL;
 	struct bind_mount * xmp = NULL;
@@ -139,4 +140,10 @@
 	/* check entitlement */
-	if (!IOCurrentTaskHasEntitlement(BINDFS_ENTITLEMENT)) {
+	/*
+	 * QEMU's unsigned init (PID 1) may mount its curated launchd job list, but
+	 * only when this kernel booted with the QEMU virtio-blk device enabled.
+	 */
+	if (!IOCurrentTaskHasEntitlement(BINDFS_ENTITLEMENT) &&
+	    !(proc_getpid(current_proc()) == 1 &&
+	    PE_parse_boot_argn("virtio_blk", &qemu_virtio, sizeof(qemu_virtio)) && qemu_virtio)) {
 		return EPERM;
 	}
