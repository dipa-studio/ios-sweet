+         * AS1 UPDATE raised bit17, and treating it as a fault aborted the
+         * first poll while firmware was still accepting the START request. */
+        if(r->fault||r->fatal||(r->mmu_raw&0xffff)||r->as_fault||
+           rd(io,mem+0x3004)) {
