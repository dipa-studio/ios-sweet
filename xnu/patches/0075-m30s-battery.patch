@@ -0,0 +1,350 @@
+/*
+ * M30S built-in iOS battery service (IOPMPowerSource).
+ *
+ * Reads from SM5713 fuel gauge via S2MPU09 PMIC on Speedy bus.
+ * Publishes battery status to iOS powerd.
+ */
+#if defined(ARM64_BOARD_CONFIG_M30S)
+#include <IOKit/IOLib.h>
+#include <IOKit/IOWorkLoop.h>
+#include <IOKit/IOTimerEventSource.h>
+#include <IOKit/pwr_mgt/IOPMPowerSource.h>
+#include <libkern/c++/OSCollectionIterator.h>
+#include <pexpert/pexpert.h>
+
+extern "C" int m30s_speedy_read(uint8_t reg, uint8_t *val);
+extern "C" int m30s_speedy_write(uint8_t reg, uint8_t val);
+
+class M30SBattery : public IOPMPowerSource {
+    OSDeclareDefaultStructors(M30SBattery);
+public:
+    bool init(OSDictionary *dictionary = NULL) APPLE_KEXT_OVERRIDE;
+    bool start(IOService *provider) APPLE_KEXT_OVERRIDE;
+    void stop(IOService *provider) APPLE_KEXT_OVERRIDE;
+    void free(void) APPLE_KEXT_OVERRIDE;
+private:
+    IOWorkLoop *fLoop;
+    IOTimerEventSource *fTimer;
+    bool fTimerAdded, fRunning;
+    int fLastMode;
+    void putNumber(const char *key, UInt32 value);
+    void putBool(const char *key, bool value);
+    void publish(unsigned percent, unsigned mv, int ma, bool external,
+        bool capable, bool charging, bool full, bool measured, bool currentValid);
+    void poll(void);
+    static void timerFired(OSObject *owner, IOTimerEventSource *sender);
+    static IOReturn stopPolling(OSObject *owner, void *, void *, void *, void *);
+    static bool readWord(uint8_t reg_lo, uint8_t reg_hi, uint16_t *value);
+    static unsigned estimatePercent(unsigned mv);
+};
+OSDefineMetaClassAndStructors(M30SBattery, IOPMPowerSource);
+
+bool
+M30SBattery::init(OSDictionary *dictionary)
+{
+    if (!IOPMPowerSource::init()) {
+        return false;
+    }
+    fLoop = NULL;
+    fTimer = NULL;
+    fTimerAdded = fRunning = false;
+    if (dictionary) {
+        OSCollectionIterator *it = OSCollectionIterator::withCollection(dictionary);
+        if (!it) {
+            return false;
+        }
+        OSObject *object;
+        bool ok = true;
+        while ((object = it->getNextObject())) {
+            const OSSymbol *key = OSDynamicCast(OSSymbol, object);
+            if (!key || !setProperty(key, dictionary->getObject(key))) {
+                ok = false;
+                break;
+            }
+        }
+        it->release();
+        if (!ok) {
+            return false;
+        }
+    }
+    fLastMode = -1;
+    return true;
+}
+
+void
+M30SBattery::putNumber(const char *key, UInt32 value)
+{
+    const OSSymbol *symbol = OSSymbol::withCString(key);
+    OSNumber *number = OSNumber::withNumber(value, 32);
+    if (symbol && number) {
+        setPSProperty(symbol, number);
+    }
+    OSSafeReleaseNULL(number);
+    OSSafeReleaseNULL(symbol);
+}
+
+void
+M30SBattery::putBool(const char *key, bool value)
+{
+    const OSSymbol *symbol = OSSymbol::withCString(key);
+    if (symbol) {
+        setPSProperty(symbol, value ? kOSBooleanTrue : kOSBooleanFalse);
+        symbol->release();
+    }
+}
+
+void
+M30SBattery::publish(unsigned percent, unsigned mv, int ma, bool external,
+    bool capable, bool charging, bool full, bool measured, bool currentValid)
+{
+    /* Use consistent mAh units (DT nominal=5020). powerd computes C*100/M. */
+    const unsigned capacity = (5020u * percent + 50u) / 100u;
+    setBatteryInstalled(true);
+    setCurrentCapacity(capacity);
+    setMaxCapacity(5020);
+    setExternalConnected(external);
+    setExternalChargeCapable(capable);
+    setIsCharging(charging);
+    setAtWarnLevel(false);
+    setAtCriticalLevel(false);
+    setVoltage(mv);
+    setAmperage(ma);
+    setTimeRemaining(-1);
+    setCycleCount(0);
+    putBool("FullyCharged", full);
+    putBool("AppleRawExternalConnected", external);
+    putNumber("AppleRawCurrentCapacity", capacity);
+    putNumber("AppleRawMaxCapacity", 5020);
+    putNumber("DesignCapacity", 5020);
+    putNumber("InstantAmperage", (UInt32)ma);
+    putNumber("Temperature", 2500);  /* 25C in centidegrees */
+    putBool("M30SBatteryHardwareSampleValid", measured);
+    putBool("M30SBatteryCurrentValid", currentValid);
+    putBool("M30SBatterySOCEstimated", measured);
+    putBool("M30SBatteryTemperatureEstimated", true);
+    putBool("M30SBatteryFallback", !measured);
+    putNumber("M30SBatteryPercent", percent);
+
+    /* IOPMCopyBatteryInfo's per-source compatibility dictionary. */
+    OSDictionary *legacy = OSDictionary::withCapacity(7);
+    if (legacy) {
+        const char *keys[] = {kIOBatteryCurrentChargeKey, kIOBatteryCapacityKey,
+            kIOBatteryVoltageKey, kIOBatteryAmperageKey, kIOBatteryCycleCountKey,
+            kIOBatteryFlagsKey};
+        UInt32 values[] = {capacity, 5020, mv, (UInt32)ma, 0,
+            (UInt32)(kIOBatteryInstalled | (external ? kIOBatteryChargerConnect : 0) |
+            (charging ? kIOBatteryCharge : 0))};
+        for (unsigned i = 0; i < sizeof(values) / sizeof(values[0]); ++i) {
+            OSNumber *number = OSNumber::withNumber(values[i], 32);
+            if (number) {
+                legacy->setObject(keys[i], number);
+                number->release();
+            }
+        }
+        setLegacyIOBatteryInfo(legacy);
+        legacy->release();
+    }
+    updateStatus();
+    int mode = measured ? 1 : 0;
+    if (mode != fLastMode) {
+        IOLog("M30S BATTERY: %s, %u%% %umV external=%d charging=%d\n",
+            measured ? "SM57150 / estimated SOC" : "static fallback",
+            percent, mv, external, charging);
+        fLastMode = mode;
+    }
+}
+
+bool
+M30SBattery::readWord(uint8_t reg_lo, uint8_t reg_hi, uint16_t *value)
+{
+    uint16_t previous = 0;
+    for (unsigned attempt = 0; attempt < 4; ++attempt) {
+        uint8_t lo, hi;
+        if (m30s_speedy_read(reg_lo, &lo) ||
+            m30s_speedy_read(reg_hi, &hi)) {
+            return false;
+        }
+        uint16_t next = (uint16_t)((unsigned)lo | ((unsigned)hi << 8));
+        if (attempt && next == previous) {
+            *value = next;
+            return true;
+        }
+        previous = next;
+    }
+    return false;
+}
+
+unsigned
+M30SBattery::estimatePercent(unsigned mv)
+{
+    /* Generic single-cell curve, intentionally NOT advertised as QG SOC. */
+    static const unsigned volts[] = {3400, 3500, 3600, 3700, 3800, 3900,
+        4000, 4100, 4200, 4350};
+    static const unsigned soc[] = {1, 5, 10, 20, 40, 60, 75, 85, 93, 100};
+    if (mv <= volts[0]) {
+        return soc[0];
+    }
+    for (unsigned i = 1; i < sizeof(volts) / sizeof(volts[0]); ++i) {
+        if (mv < volts[i]) {
+            return soc[i - 1] + (mv - volts[i - 1]) * (soc[i] - soc[i - 1]) /
+                   (volts[i] - volts[i - 1]);
+        }
+    }
+    return 100;
+}
+
+void
+M30SBattery::poll(void)
+{
+    uint8_t vcell_lo, vcell_hi, curr_lo, curr_hi, temp_lo, temp_hi, soc, status;
+    bool valid = true;
+
+    if (m30s_speedy_read(0x02, &vcell_lo) ||
+        m30s_speedy_read(0x03, &vcell_hi) ||
+        m30s_speedy_read(0x04, &curr_lo) ||
+        m30s_speedy_read(0x05, &curr_hi) ||
+        m30s_speedy_read(0x06, &temp_lo) ||
+        m30s_speedy_read(0x07, &temp_hi) ||
+        m30s_speedy_read(0x08, &soc) ||
+        m30s_speedy_read(0x00, &status)) {  /* CHG_REG_STATUS1 */
+        valid = false;
+    }
+
+    unsigned mv = valid ? ((unsigned)vcell_lo | ((unsigned)vcell_hi << 8)) : 0;
+    valid = valid && mv >= 2800 && mv <= 4600;
+
+    if (!valid) {
+        publish(100, 4200, 0, true, true, false, true, false, false);
+        return;
+    }
+
+    bool external = (status & 0x10) != 0;  /* VBUS present */
+    bool capable = external;
+    bool charging = (status & 0x01) != 0;  /* Charging active */
+    bool full = external && !charging && soc >= 100;
+
+    int16_t signed_curr = (int16_t)((unsigned)curr_lo | ((unsigned)curr_hi << 8));
+    int ma = signed_curr / 2;  /* 0.5 mA per LSB */
+
+    publish(full ? 100 : soc, mv, ma, external, capable, charging, full, true, true);
+}
+
+void
+M30SBattery::timerFired(OSObject *owner, IOTimerEventSource *sender)
+{
+    M30SBattery *self = OSDynamicCast(M30SBattery, owner);
+    if (self && self->fRunning) {
+        self->poll();
+        sender->setTimeoutMS(30000);
+    }
+}
+
+bool
+M30SBattery::start(IOService *provider)
+{
+    if (!IOPMPowerSource::start(provider)) {
+        return false;
+    }
+
+    int real = 0;
+    (void)PE_parse_boot_argn("m30sbattery", &real, sizeof(real));
+
+    if (real == 1) {
+        fLoop = IOWorkLoop::workLoop();
+        fTimer = IOTimerEventSource::timerEventSource(this, &M30SBattery::timerFired);
+        if (fLoop && fTimer && fLoop->addEventSource(fTimer) == kIOReturnSuccess) {
+            fTimerAdded = true;
+            fRunning = true;
+            fTimer->setTimeoutMS(30000);
+        } else {
+            IOLog("M30S BATTERY: timer unavailable; static fallback\n");
+        }
+    }
+
+    /* Publish initial state */
+    poll();
+    registerService();
+    return true;
+}
+
+void
+M30SBattery::stop(IOService *provider)
+{
+    if (fLoop && fTimerAdded) {
+        (void)fLoop->runAction(&M30SBattery::stopPolling, this);
+        fLoop->removeEventSource(fTimer);
+        fTimerAdded = false;
+    }
+    IOPMPowerSource::stop(provider);
+}
+
+IOReturn
+M30SBattery::stopPolling(OSObject *owner, void *, void *, void *, void *)
+{
+    M30SBattery *self = OSDynamicCast(M30SBattery, owner);
+    if (!self) {
+        return kIOReturnBadArgument;
+    }
+    self->fRunning = false;
+    self->fTimer->cancelTimeout();
+    self->fTimer->disable();
+    return kIOReturnSuccess;
+}
+
+void
+M30SBattery::free(void)
+{
+    OSSafeReleaseNULL(fTimer);
+    OSSafeReleaseNULL(fLoop);
+    IOPMPowerSource::free();
+}
+#endif /* ARM64_BOARD_CONFIG_M30S */