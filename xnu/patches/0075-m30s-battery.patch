+/*
+ * M30S Speedy (S2MPU09 PMIC) driver.
+ *
+ * Speedy is a Samsung-specific I2C master at 0x11A10000 that communicates
+ * with the S2MPU09 PMIC. The PMIC is at I2C address 0x00 on the Speedy bus.
+ * This driver provides read-only access to PMIC registers for battery monitoring.
+ * Based on Samsung exynos-speedy and s2mpu09 drivers.
+ */
+#if defined(ARM64_BOARD_CONFIG_M30S)
+#include <sys/param.h>
+#include <sys/systm.h>
+#include <sys/errno.h>
+#include <machine/machine_routines.h>
+#include <pexpert/pexpert.h>
+
+extern vm_offset_t ml_io_map(vm_offset_t, vm_size_t);
+void m30s_speedy_init(void);
+int m30s_speedy_read(uint8_t reg, uint8_t *val);
+int m30s_speedy_write(uint8_t reg, uint8_t val);
+
+#define SPEEDY_BASE		0x11A10000
+#define SPEEDY_SIZE		0x2000
+
+/* Speedy register offsets (from Samsung exynos-speedy) */
+#define SPEEDY_CFG		0x00
+#define SPEEDY_TXDATA		0x04
+#define SPEEDY_RXDATA		0x08
+#define SPEEDY_STATUS		0x0c
+#define SPEEDY_IRQ		0x10
+#define SPEEDY_IRQ_MASK		0x14
+#define SPEEDY_CMD		0x18
+#define SPEEDY_SLAVE_ADDR	0x1c
+#define SPEEDY_TIMING		0x20
+
+/* CFG register bits */
+#define CFG_MASTER_EN		(1 << 0)
+#define CFG_10BIT_ADDR		(1 << 1)
+#define CFG_HS_MODE		(1 << 2)
+#define CFG_SLAVE_ADDR_SHIFT	8
+
+/* STATUS register bits */
+#define STATUS_BUSY		(1 << 0)
+#define STATUS_TX_DONE		(1 << 1)
+#define STATUS_RX_DONE		(1 << 2)
+#define STATUS_NACK		(1 << 3)
+#define STATUS_ARB_LOST		(1 << 4)
+
+/* CMD register bits */
+#define CMD_START		(1 << 0)
+#define CMD_STOP		(1 << 1)
+#define CMD_READ		(1 << 2)
+#define CMD_WRITE		(1 << 3)
+
+static vm_offset_t speedy_regs = 0;
+static bool speedy_initialized = false;
+
+static inline uint32_t
+speedy_rd(uint32_t off)
+{
+	return *(volatile uint32_t *)(speedy_regs + off);
+}
+
+static inline void
+speedy_wr(uint32_t off, uint32_t val)
+{
+	*(volatile uint32_t *)(speedy_regs + off) = val;
+	__asm__ volatile("dsb sy" ::: "memory");
+}
+
+static void
+speedy_wait_idle(void)
+{
+	for (int i = 0; i < 10000; i++) {
+		if (!(speedy_rd(SPEEDY_STATUS) & STATUS_BUSY))
+			return;
+		delay(1);
+	}
+}
+
+static int
+speedy_xfer(uint8_t slave_addr, const uint8_t *tx, size_t tx_len, uint8_t *rx, size_t rx_len)
+{
+	if (!speedy_initialized)
+		return ENXIO;
+
+	speedy_wait_idle();
+
+	/* Set slave address */
+	speedy_wr(SPEEDY_SLAVE_ADDR, slave_addr << SPEEDY_SLAVE_ADDR_SHIFT);
+
+	/* Enable master */
+	speedy_wr(SPEEDY_CFG, CFG_MASTER_EN);
+
+	/* Write TX data */
+	for (size_t i = 0; i < tx_len; i++) {
+		speedy_wr(SPEEDY_TXDATA, tx[i]);
+		speedy_wr(SPEEDY_CMD, CMD_WRITE | CMD_START);
+		speedy_wait_idle();
+		if (speedy_rd(SPEEDY_STATUS) & STATUS_NACK) {
+			speedy_wr(SPEEDY_CMD, CMD_STOP);
+			speedy_wait_idle();
+			return ENXIO;
+		}
+	}
+
+	/* Read RX data */
+	for (size_t i = 0; i < rx_len; i++) {
+		speedy_wr(SPEEDY_CMD, CMD_READ | CMD_START | (i == rx_len - 1 ? CMD_STOP : 0));
+		speedy_wait_idle();
+		if (speedy_rd(SPEEDY_STATUS) & STATUS_NACK) {
+			speedy_wr(SPEEDY_CMD, CMD_STOP);
+			speedy_wait_idle();
+			return ENXIO;
+		}
+		rx[i] = (uint8_t)speedy_rd(SPEEDY_RXDATA);
+	}
+
+	/* Send stop */
+	speedy_wr(SPEEDY_CMD, CMD_STOP);
+	speedy_wait_idle();
+
+	return 0;
+}
+
+int
+m30s_speedy_read(uint8_t reg, uint8_t *val)
+{
+	uint8_t tx = reg;
+	return speedy_xfer(0x00, &tx, 1, val, 1);  /* S2MPU09 at address 0x00 */
+}
+
+int
+m30s_speedy_write(uint8_t reg, uint8_t val)
+{
+	uint8_t tx[2] = { reg, val };
+	return speedy_xfer(0x00, tx, 2, NULL, 0);
+}
+
+void
+m30s_speedy_init(void)
+{
+	if (speedy_initialized)
+		return;
+
+	speedy_regs = ml_io_map(SPEEDY_BASE, SPEEDY_SIZE);
+	if (!speedy_regs) {
+		printf("M30S SPEEDY: failed to map registers\n");
+		return;
+	}
+
+	/* Disable master */
+	speedy_wr(SPEEDY_CFG, 0);
+
+	/* Configure timing for 400 kHz fast mode */
+	/* PCLK = 26 MHz */
+	speedy_wr(SPEEDY_TIMING, 0x1234);  /* Placeholder - actual values from Samsung driver */
+
+	/* Mask interrupts (polled mode) */
+	speedy_wr(SPEEDY_IRQ_MASK, 0);
+
+	/* Clear any pending interrupts */
+	speedy_rd(SPEEDY_IRQ);
+
+	speedy_initialized = true;
+	printf("M30S SPEEDY: initialized at 0x%lx (S2MPU09 PMIC)\n", SPEEDY_BASE);
+}
+#endif /* ARM64_BOARD_CONFIG_M30S */
