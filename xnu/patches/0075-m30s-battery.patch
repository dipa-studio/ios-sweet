+/*
+ * M30S battery driver for SM5713 fuel gauge (via S2MPU09 PMIC on Speedy bus).
+ *
+ * Reads battery voltage, current, temperature, and SOC from SM5713 registers.
+ * Based on Samsung sec-battery and sm5713-fuelgauge drivers.
+ */
+#if defined(ARM64_BOARD_CONFIG_M30S)
+#include <sys/param.h>
+#include <sys/systm.h>
+#include <sys/errno.h>
+#include <kern/clock.h>
+#include <kern/thread.h>
+#include <kern/sched_prim.h>
+#include <machine/machine_routines.h>
+#include <pexpert/pexpert.h>
+
+extern int m30s_speedy_read(uint8_t reg, uint8_t *val);
+extern int m30s_speedy_write(uint8_t reg, uint8_t val);
+void m30s_battery_init(void);
+
+/* SM5713 fuel gauge registers (from Samsung driver) */
+#define FG_REG_DEVICE_ID		0x00
+#define FG_REG_VERSION		0x01
+#define FG_REG_VCELL_L		0x02
+#define FG_REG_VCELL_H		0x03
+#define FG_REG_CURRENT_L		0x04
+#define FG_REG_CURRENT_H		0x05
+#define FG_REG_TEMP_L		0x06
+#define FG_REG_TEMP_H		0x07
+#define FG_REG_SOC		0x08
+#define FG_REG_STATUS		0x09
+#define FG_REG_RSOC		0x0a
+#define FG_REG_FCC_L		0x0c
+#define FG_REG_FCC_H		0x0d
+#define FG_REG_RCE_L		0x0e
+#define FG_REG_RCE_H		0x0f
+#define FG_REG_CONFIG		0x10
+#define FG_REG_MODE		0x11
+
+/* S2MPU09 charger registers */
+#define CHG_REG_STATUS1		0x00
+#define CHG_REG_STATUS2		0x01
+#define CHG_REG_IRQ1		0x02
+#define CHG_REG_IRQ2		0x03
+#define CHG_REG_IRQ_MASK1	0x04
+#define CHG_REG_IRQ_MASK2	0x05
+#define CHG_REG_CNTL1		0x06
+#define CHG_REG_CNTL2		0x07
+#define CHG_REG_CNTL3		0x08
+#define CHG_REG_CNTL4		0x09
+#define CHG_REG_CNTL5		0x0a
+#define CHG_REG_CNTL6		0x0b
+#define CHG_REG_CNTL7		0x0c
+#define CHG_REG_CNTL8		0x0d
+#define CHG_REG_CNTL9		0x0e
+#define CHG_REG_INPUT_LIMIT	0x0f
+#define CHG_REG_FAST_CHG	0x10
+#define CHG_REG_TERM_CURR	0x11
+#define CHG_REG_TERM_VOLT	0x12
+#define CHG_REG_WDT		0x13
+
+static struct {
+	bool started;
+	int battery_sleep_chan;
+	int last_soc;
+	int last_voltage_mv;
+	int last_current_ma;
+	bool charger_online;
+	bool charging;
+} bat;
+
+static void
+battery_wait(unsigned ms)
+{
+	uint64_t deadline;
+	clock_interval_to_deadline(ms, NSEC_PER_MSEC, &deadline);
+	(void)assert_wait_deadline(&bat.battery_sleep_chan, THREAD_UNINT, deadline);
+	thread_block(THREAD_CONTINUE_NULL);
+}
+
+static bool
+battery_read_word(uint8_t reg_lo, uint8_t reg_hi, uint16_t *val)
+{
+	uint8_t lo, hi;
+	if (m30s_speedy_read(reg_lo, &lo) || m30s_speedy_read(reg_hi, &hi))
+		return false;
+	*val = (uint16_t)lo | ((uint16_t)hi << 8);
+	return true;
+}
+
+static int
+battery_read_soc(void)
+{
+	uint8_t soc;
+	if (m30s_speedy_read(FG_REG_SOC, &soc))
+		return -1;
+	return (int)soc;
+}
+
+static int
+battery_read_voltage_mv(void)
+{
+	uint16_t vcell;
+	if (!battery_read_word(FG_REG_VCELL_L, FG_REG_VCELL_H, &vcell))
+		return -1;
+	/* SM5713: 1 LSB = 1 mV (verify from datasheet) */
+	return (int)vcell;
+}
+
+static int
+battery_read_current_ma(void)
+{
+	uint16_t curr;
+	if (!battery_read_word(FG_REG_CURRENT_L, FG_REG_CURRENT_H, &curr))
+		return 0;
+	/* SM5713: signed 16-bit, 1 LSB = 0.5 mA (verify) */
+	int16_t signed_curr = (int16_t)curr;
+	return signed_curr / 2;
+}
+
+static int
+battery_read_temp_degc(void)
+{
+	uint16_t temp;
+	if (!battery_read_word(FG_REG_TEMP_L, FG_REG_TEMP_H, &temp))
+		return 250;  /* Default 25C */
+	/* SM5713: temperature calculation from ADC value */
+	/* Simplified: return 25C for now */
+	return 250;
+}
+
+static bool
+battery_read_charger_status(void)
+{
+	uint8_t status;
+	if (m30s_speedy_read(CHG_REG_STATUS1, &status))
+		return false;
+	bat.charger_online = (status & 0x10) != 0;  /* VBUS present */
+	bat.charging = (status & 0x01) != 0;        /* Charging active */
+	return true;
+}
+
+static void
+battery_publish(int soc, int voltage_mv, int current_ma, bool external,
+    bool capable, bool charging, bool full)
+{
+	/* Use consistent mAh units (from DT: 5020 mAh) */
+	const unsigned capacity = (5020u * (unsigned)soc + 50u) / 100u;
+
+	/* TODO: Publish via IOPMPowerSource or equivalent */
+	/* For now, just log */
+	IOLog("M30S BATTERY: %d%% %dmV %dmA ext=%d cap=%d chg=%d full=%d\n",
+	    soc, voltage_mv, current_ma, external, capable, charging, full);
+}
+
+static void
+battery_thread(void *arg, wait_result_t result)
+{
+	(void)arg;
+	(void)result;
+
+	printf("M30S BATTERY: starting poll thread\n");
+
+	while (true) {
+		int soc = battery_read_soc();
+		int voltage_mv = battery_read_voltage_mv();
+		int current_ma = battery_read_current_ma();
+		int temp_degc = battery_read_temp_degc();
+		battery_read_charger_status();
+
+		if (soc >= 0 && voltage_mv > 0) {
+			bat.last_soc = soc;
+			bat.last_voltage_mv = voltage_mv;
+			bat.last_current_ma = current_ma;
+
+			bool full = bat.charger_online && !bat.charging && soc >= 100;
+			battery_publish(soc, voltage_mv, current_ma, bat.charger_online,
+			    bat.charger_online, bat.charging, full);
+		}
+
+		/* Poll every 30 seconds */
+		battery_wait(30000);
+	}
+}
+
+void
+m30s_battery_init(void)
+{
+	int enabled = 1;
+	thread_t thread;
+
+	if (bat.started)
+		return;
+	bat.started = true;
+
+	(void)PE_parse_boot_argn("m30sbattery", &enabled, sizeof(enabled));
+	if (!enabled) {
+		printf("M30S BATTERY: disabled (m30sbattery=0)\n");
+		return;
+	}
+
+	/* Ensure Speedy is initialized */
+	m30s_speedy_init();
+
+	/* Read initial values */
+	battery_read_soc();
+	battery_read_voltage_mv();
+	battery_read_current_ma();
+	battery_read_charger_status();
+
+	kern_return_t kr = kernel_thread_start(battery_thread, NULL, &thread);
+	if (kr == KERN_SUCCESS) {
+		thread_deallocate(thread);
+	} else {
+		printf("M30S BATTERY: kernel_thread_start failed %d\n", kr);
+	}
+}
+#endif /* ARM64_BOARD_CONFIG_M30S */
