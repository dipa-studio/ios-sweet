+/* Both the periodic writer and GPU diagnostic checkpoints use this lock.
+ * A checkpoint acknowledges the header and UFS cache sync, not a sleep. */
+static uint64_t sweet_log_flushed, sweet_log_sequence;
+int sweet_gpu_log_flush(void);
+int
+sweet_gpu_log_flush(void)
+{
+	if (!su.dma || su.nblocks < 2 * SWEET_LOG_BLOCKS) return ENXIO;
+	uint64_t base = su.first_block + su.nblocks - SWEET_LOG_BLOCKS;
+	void *bounce = (void *)(su.dma + DMA_BOUNCE);
+	int error = 0;
+	lck_mtx_lock(&sweet_ufs_lock);
+	uint64_t total = os_atomic_load(&sweet_log_total, acquire);
+	if (total == sweet_log_flushed) {
+		lck_mtx_unlock(&sweet_ufs_lock);
+		return 0;
+	}
+	uint64_t pos = total - sweet_log_flushed >= SWEET_LOG_SIZE ?
+	    total - SWEET_LOG_SIZE : sweet_log_flushed;
+	while (pos < total && !error) {
+		uint32_t off = (uint32_t)(pos % SWEET_LOG_SIZE);
+		uint32_t blk = off / UFS_BLOCK;
+		uint64_t need = ((uint64_t)off % UFS_BLOCK + (total - pos) + UFS_BLOCK - 1) / UFS_BLOCK;
+		uint32_t n = (uint32_t)MIN(MIN(need, (uint64_t)(SWEET_LOG_SIZE / UFS_BLOCK - blk)),
+		    (uint64_t)(BOUNCE_SIZE / UFS_BLOCK));
+		memcpy(bounce, sweet_log_ring + (uint64_t)blk * UFS_BLOCK, n * UFS_BLOCK);
+		error = ufs_write_blocks_checked(base + 1 + blk, n, true);
+		pos += (uint64_t)(blk + n) * UFS_BLOCK - off;
+	}
+	if (!error) {
+		struct sweet_log_header h = {
+			.magic = { 'S', 'W', 'E', 'E', 'T', 'L', 'O', 'G' },
+			.version = 1, .size = SWEET_LOG_SIZE, .total = total,
+			.seq = sweet_log_sequence + 1,
+		};
+		bzero(bounce, UFS_BLOCK);
+		memcpy(bounce, &h, sizeof(h));
+		error = ufs_write_blocks_checked(base, 1, true);
+	}
+	if (!error) error = ufs_sync_cache();
+	if (!error) {
+		sweet_log_flushed = total;
+		sweet_log_sequence++;
+		os_atomic_store(&sweet_log_has_flushed, 1, release);
+	}
+	lck_mtx_unlock(&sweet_ufs_lock);
+	return error;
+}
