+/* launchd filters DYLD_* from job dictionaries. Add the one fixed library
+ * after copying the environment, as HakiOS does at exec. Keep this bring-up
+ * path opt-in and confined to the 64-bit window server. */
+static TUNABLE(uint32_t, sweet_gles_exec_enabled, "sweetgles", 0);
+
+static int
+sweet_gles_exec_env(struct image_params *imgp, int ptr_size)
+{
+	static const char name[] = "backboardd";
+	static const char key[] = "DYLD_INSERT_LIBRARIES=";
+	static const char value[] =
+	    "DYLD_INSERT_LIBRARIES=/usr/local/sweet/lib/libsweet-gles-loader.dylib";
+	const char *env = imgp->ip_endargv;
+	int error;
+
+	if (sweet_gles_exec_enabled != 1 || ptr_size != 8 || imgp->ip_ndp == NULL ||
+	    imgp->ip_ndp->ni_cnd.cn_namelen != sizeof(name) - 1 ||
+	    strncmp(imgp->ip_ndp->ni_cnd.cn_nameptr, name, sizeof(name) - 1) != 0) {
+		return 0;
+	}
+	/* If a caller already passed it, avoid duplicate DYLD entries. Refuse a
+	 * conflicting value rather than silently loading a different library. */
+	for (int i = 0; i < imgp->ip_envc; i++, env += strlen(env) + 1) {
+		if (strncmp(env, key, sizeof(key) - 1) == 0) {
+			if (strcmp(env, value) != 0) {
+				return EINVAL;
+			}
+			printf("SWEET GLES: backboardd exec loader environment already set\n");
+			return 0;
+		}
+	}
+	if (imgp->ip_argspace < ptr_size) {
+		return E2BIG;
+	}
+	error = exec_add_user_string(imgp, CAST_USER_ADDR_T(value), UIO_SYSSPACE, TRUE);
+	if (error) {
+		return error;
+	}
+	if (imgp->ip_argspace < ptr_size) {
+		return E2BIG;
+	}
+	imgp->ip_argspace -= ptr_size;
+	imgp->ip_envc++;
+	printf("SWEET GLES: backboardd exec loader environment added\n");
+	return 0;
+}
