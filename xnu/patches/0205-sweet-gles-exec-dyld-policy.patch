+/* iOS 16.7 dyld: __mac_syscall("AMFI", 90, { uint64_t in, user_addr_t out }).
+ * Verified in 20H392 dyld and HakiOS kern_minimac.c. Its missing-policy path
+ * returns no permissions, so merely putting DYLD_INSERT_LIBRARIES in a job
+ * cannot activate the bridge. Only opt-in backboardd gets path/print vars;
+ * no custom cache, interposing or ignored insertion failures are enabled. */
+static TUNABLE(uint32_t, sweet_gles_dyld_enabled, "sweetgles", 0);
+
+static int
+sweet_amfi_policy_syscall(proc_t p, int call, user_addr_t arg)
+{
+	struct {
+		uint64_t input_flags;
+		user_addr_t output_flags;
+	} args;
+	char name[32] = { 0 };
+	uint64_t flags = (1ULL << 1) | (1ULL << 4);
+	int error;
+
+	if (call != 90 || sweet_gles_dyld_enabled != 1 || !proc_is64bit_data(p)) {
+		return ENOPOLICY;
+	}
+	proc_name(proc_pid(p), name, sizeof(name));
+	if (strcmp(name, "backboardd") != 0) {
+		return ENOPOLICY;
+	}
+	error = copyin(arg, &args, sizeof(args));
+	if (error == 0) {
+		error = copyout(&flags, args.output_flags, sizeof(flags));
+		printf("SWEET GLES: backboardd AMFI dyld in=0x%llx out=0x%llx error=%d\n",
+		    args.input_flags, flags, error);
+	}
+	return error;
+}
+
 static const struct mac_policy_ops sweet_amfi_mac_ops = {
+	.mpo_policy_syscall = sweet_amfi_policy_syscall,
 	.mpo_vnode_check_signature = sweet_amfi_vnode_check_signature,
 };
 
