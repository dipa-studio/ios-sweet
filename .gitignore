# device dumps: persist/modemst/fsg hold IMEI + calibration; live DT holds the serial
backup/
dtb/
recovery/
# Apple restore packages and filesystem components
*.ipsw
*.dmg
# third-party/Apple sources fetched for reading
research/
shim/out/
xnu/out/
xnu/out-*/
__pycache__/
# build output: disk images, local logs, caches and secrets must never be committed
output/
logs/
*.img
*.simg
*.log
.cache/
.env
.env.*
